DATABASE_URL=postgresql://nycuee:local-development@localhost:5432/nycuee
PORT=3000
COOKIE_SECURE=false
# Enable only behind the supplied Caddy proxy. Leave false for direct local access.
TRUST_PROXY=false
# Frontend origin; never derived from request Host headers. No path or hash.
APP_ORIGIN=http://localhost:5173
# Required only when creating the first admin in production (12–1024 characters).
ADMIN_INITIAL_PASSWORD=
# Optional: configure both values to enable Google OIDC.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional local upload directory. Defaults to backend/media when run from backend.
MEDIA_ROOT=./media
