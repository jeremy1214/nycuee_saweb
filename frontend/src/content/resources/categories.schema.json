{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "學習資料分類設定",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaultCategory",
    "categories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultCategory": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "searchDescription"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "searchDescription": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
