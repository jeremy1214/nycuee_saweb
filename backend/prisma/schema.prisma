generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         Role      @default(EDITOR)
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id
  csrfHash  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
  @@index([userId])
}

model LoginAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
