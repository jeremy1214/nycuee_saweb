FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
COPY shared /shared
ARG VITE_SITE_CONTENT_SOURCE=json
ENV VITE_SITE_CONTENT_SOURCE=${VITE_SITE_CONTENT_SOURCE}
ARG VITE_EESA_SOURCE=json
ARG VITE_TEAM_SOURCE=json
ENV VITE_EESA_SOURCE=${VITE_EESA_SOURCE}
ENV VITE_TEAM_SOURCE=${VITE_TEAM_SOURCE}
ARG VITE_ACTIVITY_SOURCE=api
ENV VITE_ACTIVITY_SOURCE=${VITE_ACTIVITY_SOURCE}
# Build directly so the existing npm prebuild test hook is not invoked.
RUN ./node_modules/.bin/tsc -b && ./node_modules/.bin/vite build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 80 443
