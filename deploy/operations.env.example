# Store the real file outside the checkout, owned by root with mode 0600.
CMS_ENV_FILE=/srv/nycuee/.env
CMS_BACKUP_STATE_DIR=/var/lib/nycuee-operations
CMS_BACKUP_STAGING_DIR=/var/lib/nycuee-staging
CMS_BACKUP_HOST=nycuee-production
RESTIC_REPOSITORY=sftp:backup-host:/encrypted/nycuee
RESTIC_PASSWORD_FILE=/etc/nycuee/restic-password
# Configure SSH host keys and a restricted backup account separately.
CMS_HEALTH_ORIGIN=https://replace.example
CMS_ALERT_WEBHOOK=https://replace.example/cms-alert
# Host mountpoints for the actual media/database volumes, not container paths.
CMS_MEDIA_FILESYSTEM=/var/lib/docker
CMS_DATABASE_FILESYSTEM=/var/lib/docker
CMS_BACKUP_MAX_AGE_SECONDS=93600
CMS_MIN_FREE_BYTES=2147483648
