{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nycuee.example/schemas/activity.json",
  "title": "活動內容資料",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "title", "categoryId", "summary", "details"],
  "allOf": [{ "if": { "required": ["album"] }, "then": { "required": ["detail"] } }],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "published", "archived"] },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "categoryId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "summary": { "type": "string", "minLength": 1 },
    "details": { "type": "string", "minLength": 1 },
    "location": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "album": { "$ref": "#/$defs/album" },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "intro", "heroImages", "sections"],
      "allOf": [
        {
          "if": { "properties": { "introMode": { "const": "shared" } }, "required": ["introMode"] },
          "then": { "required": ["tabs"] }
        }
      ],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "intro": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "introMode": { "enum": ["tab", "shared"] },
        "heroImages": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/image" } },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
        "tabs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tab" } }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "url": { "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://\\S+$" }
      }
    },
    "album": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "cover", "photos"],
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "cover": { "$ref": "#/$defs/image" },
        "photos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/image" } }
      }
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "navLabel", "sections"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "not": { "const": "intro" } },
        "navLabel": { "type": "string", "minLength": 1 },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "pattern": "^/" },
        "alt": { "type": "string", "minLength": 1 },
        "objectPosition": { "type": "string", "minLength": 1 },
        "fit": { "enum": ["cover", "contain"] }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "navLabel", "eyebrow", "title", "paragraphs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "navLabel": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "image": { "$ref": "#/$defs/image" }
      }
    }
  }
}
