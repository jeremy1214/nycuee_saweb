{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "學習資料分類內容",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "links"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "description",
          "href"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "pattern": "\\S"
          },
          "href": {
            "type": "string",
            "format": "uri",
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s]+$"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 0,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "title",
              "items"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "type": {
                "const": "process"
              },
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "description"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "description": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "title",
              "items"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "type": {
                "const": "checklist"
              },
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      }
    }
  }
}
