{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nycuee.example/schemas/activity.json",
  "title": "活動內容資料",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "title", "date", "categoryId", "summary", "details", "location"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["draft", "published", "archived"] },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "categoryId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "summary": { "type": "string", "minLength": 1 },
    "details": { "type": "string", "minLength": 1 },
    "location": { "type": "string", "minLength": 1 },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "intro", "heroImages", "sections"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "intro": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "heroImages": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/image" } },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "pattern": "^/" },
        "alt": { "type": "string", "minLength": 1 },
        "objectPosition": { "type": "string", "minLength": 1 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "navLabel", "eyebrow", "title", "paragraphs", "image"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "navLabel": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "image": { "$ref": "#/$defs/image" }
      }
    }
  }
}
