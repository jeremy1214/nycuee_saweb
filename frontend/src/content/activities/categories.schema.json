{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nycuee.example/schemas/activity-categories.json",
  "title": "活動分類資料",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories"],
  "properties": {
    "$schema": { "type": "string" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "shortLabel"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "shortLabel": { "type": "string", "minLength": 1 },
          "featuredActivityId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
