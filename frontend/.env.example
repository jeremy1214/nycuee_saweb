# Optional override. Empty uses the built-in API on the same origin.
# A static-only deployment can set an external JSON POST endpoint instead.
VITE_CONTACT_FORM_ENDPOINT=

# api (default) or json for an explicitly static-only deployment.
VITE_ACTIVITY_SOURCE=api

# Admin CMS uses live API by default. Set mock for the in-memory demo.
VITE_ADMIN_SOURCE=api

# Keep json until organization content is imported; switch both to api for CMS.
VITE_EESA_SOURCE=json
VITE_TEAM_SOURCE=json
