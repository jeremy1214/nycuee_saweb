generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String?
  role         Role      @default(EDITOR)
  enabled      Boolean   @default(true)
  version      Int       @default(1)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  googleIdentity GoogleIdentity?
  passwordTokens PasswordToken[]
  categoryGrants CategoryGrant[]
  activityGrants ActivityGrant[]
  departmentGrants DepartmentGrant[]
  teamGrants TeamGrant[]
  uploadedMedia Media[]
  auditEntries AuditEntry[]
}

model Session {
  id        String   @id
  csrfHash  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  googleFlows GoogleAuthFlow[]

  @@index([expiresAt])
  @@index([userId])
}

// Short-lived, one-use OIDC flows are bound to the initiating browser Session.
model GoogleAuthFlow {
  stateHash   String   @id @db.VarChar(64)
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nonceHash   String   @db.VarChar(64)
  verifier    String
  linkUserId  String?
  userVersion Int?
  expiresAt   DateTime

  @@index([sessionId])
  @@index([expiresAt])
}

model LoginAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

enum ContactCategory {
  association
  activities
  teams
  resources
  website
  other
}

model ContactMessage {
  id        String          @id @default(cuid())
  name      String          @db.VarChar(60)
  email     String          @db.VarChar(120)
  category  ContactCategory
  subject   String          @db.VarChar(120)
  message   String          @db.VarChar(2000)
  createdAt DateTime        @default(now())
  readAt    DateTime?

  @@index([createdAt, id])
  @@index([readAt, createdAt, id])
}

model ContactSubmissionAttempt {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// Workflow and publication are independent: a new draft never replaces the public pointer.
enum ActivityRevisionStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

model ActivityCategory {
  id                 String             @id
  label              String             @unique
  shortLabel         String
  order              Int                @default(0)
  version            Int                @default(1)
  featuredActivityId String?
  featuredActivity   Activity?          @relation("FeaturedActivity", fields: [featuredActivityId], references: [id], onDelete: Restrict)
  revisions          ActivityRevision[]
  grants             CategoryGrant[]
  media              Media[]
}

model Activity {
  // Stable legacy slug, never changed after creation.
  id                  String             @id
  version             Int                @default(1)
  publishedRevisionId String?
  workingRevisionId   String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  revisions           ActivityRevision[] @relation("ActivityRevisions")
  // Composite foreign keys prevent pointing at another activity's revision.
  publishedRevision   ActivityRevision?  @relation("PublishedRevision", fields: [id, publishedRevisionId], references: [activityId, id], onDelete: NoAction, onUpdate: NoAction)
  workingRevision     ActivityRevision?  @relation("WorkingRevision", fields: [id, workingRevisionId], references: [activityId, id], onDelete: NoAction, onUpdate: NoAction)
  featuredIn          ActivityCategory[] @relation("FeaturedActivity")
  grants              ActivityGrant[]
  media               Media[]
}

model ActivityRevision {
  id            String                 @id @default(cuid())
  activityId    String
  number        Int
  status        ActivityRevisionStatus @default(DRAFT)
  title         String
  categoryId    String
  // Date-only values, with inclusive endDate; API uses YYYY-MM-DD.
  date          DateTime?              @db.Date
  endDate       DateTime?              @db.Date
  summary       String
  details       String
  location      String?
  links         Json                   @default("[]") @db.JsonB
  detail        Json?                  @db.JsonB
  album         Json?                  @db.JsonB
  rejectionNote String?
  submittedAt   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  activity      Activity               @relation("ActivityRevisions", fields: [activityId], references: [id], onDelete: Cascade)
  category      ActivityCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  publishedFor  Activity[]             @relation("PublishedRevision")
  workingFor    Activity[]             @relation("WorkingRevision")
  mediaReferences MediaReference[]

  @@unique([activityId, number])
  @@unique([activityId, id])
  @@index([categoryId, date])
  @@index([status, updatedAt])
}

// Subject mapping is the Google allowlist; email never merges accounts.
model GoogleIdentity {
  id        String   @id @default(cuid())
  userId    String   @unique
  subject   String   @unique
  email     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PasswordTokenPurpose {
  ACTIVATE
  RESET
}

model PasswordToken {
  id        String               @id @default(cuid())
  userId    String
  tokenHash String               @unique @db.VarChar(64)
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model CategoryGrant {
  userId     String
  categoryId String
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model ActivityGrant {
  userId     String
  activityId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
  @@index([activityId])
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
}

model Media {
  id           String          @id @default(cuid())
  storageKey   String          @unique
  originalName String
  mimeType     String
  byteSize     Int
  width        Int
  height       Int
  sha256       String          @db.VarChar(64)
  visibility   MediaVisibility @default(PRIVATE)
  uploadedById String?
  activityId   String?
  categoryId   String?
  overviewId   String?
  departmentId String?
  teamId       String?
  siteContentId String?
  siteContent SiteContent? @relation(fields: [siteContentId], references: [id], onDelete: Restrict)
  siteReferences SiteContentMediaReference[]
  revokedAt DateTime?
  overview     EesaOverview? @relation(fields: [overviewId], references: [id], onDelete: Restrict)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team         Team? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  overviewReferences EesaOverviewMediaReference[]
  departmentReferences DepartmentMediaReference[]
  teamReferences TeamMediaReference[]
  createdAt    DateTime        @default(now())
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  activity     Activity?       @relation(fields: [activityId], references: [id], onDelete: Restrict)
  category     ActivityCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  references   MediaReference[]

  @@index([uploadedById, createdAt])
  @@index([sha256])
}

model MediaReference {
  revisionId String
  path       String
  mediaId    String
  revision   ActivityRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media      Media            @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([revisionId, path])
  @@index([mediaId])
}

model AuditEntry {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?    @db.JsonB
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model EesaOverview {
  id String @id
  version Int @default(1)
  publishedRevisionId String?
  workingRevisionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions EesaOverviewRevision[] @relation("EesaOverviewRevisions")
  publishedRevision EesaOverviewRevision? @relation("EesaOverviewPublished", fields: [id, publishedRevisionId], references: [resourceId, id], onDelete: NoAction, onUpdate: NoAction)
  workingRevision EesaOverviewRevision? @relation("EesaOverviewWorking", fields: [id, workingRevisionId], references: [resourceId, id], onDelete: NoAction, onUpdate: NoAction)
  media Media[]
}
model EesaOverviewRevision {
  id String @id @default(cuid())
  resourceId String
  number Int
  status ActivityRevisionStatus @default(DRAFT)
  content Json @db.JsonB
  rejectionNote String?
  submittedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resource EesaOverview @relation("EesaOverviewRevisions", fields: [resourceId], references: [id], onDelete: Cascade)
  publishedFor EesaOverview[] @relation("EesaOverviewPublished")
  workingFor EesaOverview[] @relation("EesaOverviewWorking")
  mediaReferences EesaOverviewMediaReference[]
  @@unique([resourceId, number])
  @@unique([resourceId, id])
  @@index([status, updatedAt])
}
model EesaOverviewMediaReference {
  revisionId String
  path String
  mediaId String
  revision EesaOverviewRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([revisionId, path])
  @@index([mediaId])
}

model Department {
  id String @id
  version Int @default(1)
  publishedRevisionId String?
  workingRevisionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions DepartmentRevision[] @relation("DepartmentRevisions")
  publishedRevision DepartmentRevision? @relation("DepartmentPublished", fields: [id, publishedRevisionId], references: [resourceId, id], onDelete: NoAction, onUpdate: NoAction)
  workingRevision DepartmentRevision? @relation("DepartmentWorking", fields: [id, workingRevisionId], references: [resourceId, id], onDelete: NoAction, onUpdate: NoAction)
  media Media[]
  grants DepartmentGrant[]
}
model DepartmentRevision {
  id String @id @default(cuid())
  resourceId String
  number Int
  status ActivityRevisionStatus @default(DRAFT)
  content Json @db.JsonB
  rejectionNote String?
  submittedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resource Department @relation("DepartmentRevisions", fields: [resourceId], references: [id], onDelete: Cascade)
  publishedFor Department[] @relation("DepartmentPublished")
  workingFor Department[] @relation("DepartmentWorking")
  mediaReferences DepartmentMediaReference[]
  @@unique([resourceId, number])
  @@unique([resourceId, id])
  @@index([status, updatedAt])
}
model DepartmentMediaReference {
  revisionId String
  path String
  mediaId String
  revision DepartmentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([revisionId, path])
  @@index([mediaId])
}
model DepartmentGrant {
  userId String
  departmentId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@id([userId, departmentId])
  @@index([departmentId])
}

model Team {
  id String @id
  version Int @default(1)
  publishedRevisionId String?
  workingRevisionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions TeamRevision[] @relation("TeamRevisions")
  publishedRevision TeamRevision? @relation("TeamPublished", fields: [id, publishedRevisionId], references: [resourceId, id], onDelete: NoAction, onUpdate: NoAction)
  workingRevision TeamRevision? @relation("TeamWorking", fields: [id, workingRevisionId], references: [resourceId, id], onDelete: NoAction, onUpdate: NoAction)
  media Media[]
  grants TeamGrant[]
}
model TeamRevision {
  id String @id @default(cuid())
  resourceId String
  number Int
  status ActivityRevisionStatus @default(DRAFT)
  content Json @db.JsonB
  rejectionNote String?
  submittedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resource Team @relation("TeamRevisions", fields: [resourceId], references: [id], onDelete: Cascade)
  publishedFor Team[] @relation("TeamPublished")
  workingFor Team[] @relation("TeamWorking")
  mediaReferences TeamMediaReference[]
  @@unique([resourceId, number])
  @@unique([resourceId, id])
  @@index([status, updatedAt])
}
model TeamMediaReference {
  revisionId String
  path String
  mediaId String
  revision TeamRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([revisionId, path])
  @@index([mediaId])
}
model TeamGrant {
  userId String
  teamId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@id([userId, teamId])
  @@index([teamId])
}

model SiteContent {
  id String @id
  version Int @default(1)
  publishedRevisionId String?
  workingRevisionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions SiteContentRevision[] @relation("SiteRevisions")
  publishedRevision SiteContentRevision? @relation("SitePublished", fields: [id, publishedRevisionId], references: [resourceId, id], onDelete: NoAction, onUpdate: NoAction)
  workingRevision SiteContentRevision? @relation("SiteWorking", fields: [id, workingRevisionId], references: [resourceId, id], onDelete: NoAction, onUpdate: NoAction)
  media Media[]
}
model SiteContentRevision {
  id String @id @default(cuid())
  resourceId String
  number Int
  status ActivityRevisionStatus @default(DRAFT)
  content Json @db.JsonB
  rejectionNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resource SiteContent @relation("SiteRevisions", fields: [resourceId], references: [id], onDelete: Cascade)
  publishedFor SiteContent[] @relation("SitePublished")
  workingFor SiteContent[] @relation("SiteWorking")
  mediaReferences SiteContentMediaReference[]
  @@unique([resourceId, number])
  @@unique([resourceId, id])
}
model SiteContentMediaReference {
  revisionId String
  mediaId String
  path String
  revision SiteContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([revisionId, path])
  @@index([mediaId])
}
